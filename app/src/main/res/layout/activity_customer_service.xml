<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_pale"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹ Back"
        android:textColor="@color/green_primary"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="We're here to help"
        android:textColor="@color/text_dark"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="Reach the Zumar team directly"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnWhatsapp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_whatsapp"
        android:drawableStart="@drawable/ic_whatsapp"
        android:drawablePadding="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical|start"
        android:text="Chat on WhatsApp · 09166889556"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:elevation="0dp"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnCall"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_call"
        android:drawablePadding="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical|start"
        android:text="Call us · 07060698438"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:elevation="0dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Available every day for Zumar family and friends."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
