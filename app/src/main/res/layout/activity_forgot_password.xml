<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_pale">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/btnFpBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ Back to login"
                android:textColor="@color/green_primary"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_marginBottom="20dp" />

            <!-- STEP 1: identify -->
            <LinearLayout
                android:id="@+id/stepIdentify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset your password"
                    android:textColor="@color/text_dark"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="Enter the email or phone number on your account"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp" />

                <EditText
                    android:id="@+id/etFpIdentifier"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email or phone number"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvFpIdentifyError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error_red"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFpSendCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Send reset code"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:elevation="0dp" />
            </LinearLayout>

            <!-- STEP 2: otp -->
            <LinearLayout
                android:id="@+id/stepOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFpOtpTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter the code sent to your account"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_otp_banner"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Demo mode — no real email is sent here."
                        android:textColor="@color/otp_text"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvFpDemoCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Your code is 0000"
                        android:textColor="@color/otp_text"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etFpOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Enter code"
                    android:inputType="number"
                    android:maxLength="4"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvFpOtpError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error_red"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFpVerifyCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Verify code"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:elevation="0dp" />
            </LinearLayout>

            <!-- STEP 3: reset -->
            <LinearLayout
                android:id="@+id/stepReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set a new password"
                    android:textColor="@color/text_dark"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="Choose something you haven't used before"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp" />

                <EditText
                    android:id="@+id/etFpNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="New password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etFpConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Confirm new password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvFpResetError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error_red"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFpUpdatePassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Update password"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:elevation="0dp" />
            </LinearLayout>

            <!-- STEP 4: done -->
            <LinearLayout
                android:id="@+id/stepDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password updated"
                    android:textColor="@color/text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="You can now log in with your new password."
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/btnFpBackToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Back to login"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:elevation="0dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
